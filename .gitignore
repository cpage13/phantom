*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
wheels/
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- uv / virtualenv -----------------------------------------------------------
.venv/

# --- IDE / editors -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ------------------------------------------------------------------------
.DS_Store
Thumbs.db

